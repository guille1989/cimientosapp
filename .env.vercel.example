# Copia estos valores a Settings > Environment Variables de Vercel.
# NO subas un archivo con credenciales al repositorio.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/cimiento?sslmode=require&connection_limit=1&pool_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/cimiento?sslmode=require"
DEMO_MODE=true
REFLECTION_HOURS=96
# Carga inicial idempotente de proyectos y las tres cuentas ficticias.
# Tras el primer despliegue puedes cambiarlo a false.
SEED_DEMO_DATA=true
# Opcional, solo en Production si utilizas un dominio fijo. Sin barra final.
# En Preview omítela para aceptar el dominio propio del despliegue.
# APP_ORIGIN="https://tu-proyecto.vercel.app"
# Se conserva el límite local por instancia; no es un limitador distribuido.
TRUST_PROXY=false
