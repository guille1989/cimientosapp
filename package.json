{
  "name": "cimiento-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/ensure-db.mjs && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/ensure-db.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:sync:postgres": "node scripts/sync-postgres-schema.mjs",
    "db:generate:postgres": "node scripts/sync-postgres-schema.mjs && prisma generate --schema prisma/postgresql/schema.prisma",
    "db:deploy:postgres": "node scripts/deploy-database.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "24.x"
  }
}
